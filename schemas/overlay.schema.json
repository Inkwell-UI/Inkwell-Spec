{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "specVersion": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "instanceName": {
            "type": "string"
          },
          "focus": {
            "type": "object",
            "properties": {
              "order": {
                "type": "number"
              },
              "overrides": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": {}
          },
          "dataBinding": {
            "type": "string"
          },
          "scripts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "anchor": {
            "type": "object",
            "properties": {
              "h": {
                "type": "string"
              },
              "v": {
                "type": "string"
              }
            },
            "additionalProperties": {}
          },
          "list": {
            "type": "object",
            "properties": {
              "itemTemplate": {
                "type": "string"
              },
              "spacing": {
                "type": "number"
              }
            },
            "additionalProperties": {}
          },
          "locKey": {
            "type": "string",
            "pattern": "^\\$[A-Za-z0-9_]{1,96}$"
          },
          "font": {
            "type": "string"
          },
          "themable": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "specVersion",
    "nodes"
  ],
  "additionalProperties": {}
}
