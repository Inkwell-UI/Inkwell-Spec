{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$"
          },
          "latest": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
          },
          "description": {
            "type": "string"
          },
          "deprecated": {
            "type": "string",
            "minLength": 1
          },
          "extra": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "repo",
          "latest"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "packs"
  ],
  "additionalProperties": {}
}
