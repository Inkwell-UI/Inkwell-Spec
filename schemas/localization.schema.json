{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "specVersion": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Z]{3,20}$"
    },
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3,20}$"
      }
    },
    "entries": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^\\$[A-Za-z0-9_]{1,96}$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[A-Z]{3,20}$"
        },
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "specVersion",
    "namespace",
    "source",
    "languages"
  ],
  "additionalProperties": {}
}
