{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "helloAck"
        },
        "ok": {
          "type": "boolean"
        },
        "editorVersion": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "ok",
        "editorVersion",
        "protocolVersion"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resend"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "ids"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "status"
        },
        "state": {
          "type": "string",
          "enum": [
            "synced",
            "compiling",
            "error"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "nodeId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "type",
        "state"
      ],
      "additionalProperties": {}
    }
  ]
}
