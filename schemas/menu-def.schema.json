{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "specVersion": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{1,63}$"
    },
    "swf": {
      "type": "string"
    },
    "minRuntime": {
      "default": "0.3.0",
      "type": "string",
      "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
    },
    "flags": {
      "default": {
        "pausesGame": false,
        "cursor": false,
        "modal": false,
        "closeOnEscape": true
      },
      "type": "object",
      "properties": {
        "pausesGame": {
          "default": false,
          "type": "boolean"
        },
        "cursor": {
          "default": false,
          "type": "boolean"
        },
        "modal": {
          "default": false,
          "type": "boolean"
        },
        "closeOnEscape": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "inputContext": {
      "type": "string",
      "enum": [
        "none",
        "menuMode"
      ]
    },
    "depth": {
      "default": 3,
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "triggers": {
      "default": {
        "papyrus": true
      },
      "type": "object",
      "properties": {
        "hotkey": {
          "type": "integer",
          "minimum": 2,
          "maximum": 255
        },
        "papyrus": {
          "default": true,
          "type": "boolean"
        },
        "modEvent": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,64}$"
        }
      },
      "additionalProperties": {}
    },
    "extra": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "specVersion",
    "name",
    "swf"
  ],
  "additionalProperties": {}
}
