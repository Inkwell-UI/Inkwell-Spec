{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "compatible": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "runtimeApi": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tool"
      ],
      "additionalProperties": {}
    },
    "dependencies": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "extra": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "version",
    "compatible"
  ],
  "additionalProperties": {}
}
